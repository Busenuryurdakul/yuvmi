# Yuvmi Web — local development
# Copy to .env.local (not committed) and adjust as needed.

# Public Go API base URL (no trailing slash). Local API listens on 8080.
# Expo Metro is 8081 — do not point the Next.js app there.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# When running the API locally, also set on the API process:
# CORS_ALLOWED_ORIGINS=http://localhost:3000
