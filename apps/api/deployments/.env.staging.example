# Copy to deployments/.env.staging and fill secrets before `docker compose up`

JWT_SECRET=change-me-staging-secret-min-32-chars
DB_USER=yuvmi
DB_PASSWORD=yuvmi
DB_NAME=yuvmi
S3_BUCKET=yuvmi-assets
S3_ACCESS_KEY=yuvmi
S3_SECRET_KEY=yuvmi-secret-key
S3_PUBLIC_BASE=http://localhost:9000/yuvmi-assets
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_APPLE_BUNDLE_ID=com.yuvmi.app
CORS_ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081

# Dev bridges — keep 0 in staging/prod
YUVMI_ALLOW_DEV_OAUTH=0
YUVMI_ALLOW_DEV_PREMIUM=0
YUVMI_LOG_PASSWORD_RESET=1
YUVMI_APP_BASE_URL=yuvmi://

# Stripe — required for premium checkout in staging/prod
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=yuvmi://premium?checkout=success
STRIPE_CANCEL_URL=yuvmi://premium?checkout=cancel
