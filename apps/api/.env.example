# Yuvmi API — local development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=dev-yuvmi-secret-change-in-production
JWT_ISSUER=yuvmi
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

DB_HOST=localhost
DB_PORT=5432
DB_USER=yuvmi
DB_PASSWORD=yuvmi
DB_NAME=yuvmi
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_ENABLED=false

LOG_LEVEL=info
LOG_FORMAT=text

# Faz 4 — dev ortamında POST /api/v1/subscription/dev-upgrade
YUVMI_ALLOW_DEV_PREMIUM=1
