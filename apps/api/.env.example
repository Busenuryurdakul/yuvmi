# Yuvmi API — local development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
JWT_SECRET=dev-yuvmi-secret-change-in-production
JWT_ISSUER=yuvmi
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=30
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

DB_HOST=localhost
DB_PORT=5432
DB_USER=yuvmi
DB_PASSWORD=yuvmi
DB_NAME=yuvmi
DB_SSLMODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_ENABLED=false

LOG_LEVEL=info
LOG_FORMAT=text

# OAuth — comma-separated Google client IDs (web, iOS, Android)
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_APPLE_BUNDLE_ID=com.yuvmi.app

# Dev bridges — set to 0 before staging/prod
YUVMI_ALLOW_DEV_OAUTH=1
YUVMI_ALLOW_DEV_PREMIUM=1
YUVMI_DEV_OAUTH_PASSWORD=yuvmi-dev-12345678
YUVMI_LOG_PASSWORD_RESET=1
YUVMI_APP_BASE_URL=http://localhost:8081

# Object storage — local by default; use s3 + MinIO for staging
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=yuvmi-assets
# S3_ACCESS_KEY=yuvmi
# S3_SECRET_KEY=yuvmi-secret-key
# S3_USE_SSL=false
# S3_PUBLIC_BASE=http://localhost:9000/yuvmi-assets

# Push notification cron
CRON_ENABLED=true
CRON_PUSH_INTERVAL_MINUTES=15
CRON_DAILY_REMINDER_HOUR=9
CRON_WEEKLY_REMINDER_DAY=0

# Stripe (prod/staging — leave empty for local dev-only premium bridge)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=
# STRIPE_SUCCESS_URL=yuvmi://premium?checkout=success
# STRIPE_CANCEL_URL=yuvmi://premium?checkout=cancel

# Optional SMTP for password reset emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@yuvmi.app

# --- AI (opsiyonel) ---
# Anahtar yoksa AI öneri uçları 501 döner ve mobil uygulama kendi statik
# listesine düşer. Consent uçları her durumda çalışır.
#
# AI_PROVIDER: "anthropic", "gemini" veya "openai". Tanınmayan bir değer
# sunucuyu başlatmaz — sessizce varsayılana düşmek yanlış hesabı
# faturalandırırdı.
AI_PROVIDER=anthropic

# Anahtar seçili sağlayıcıya göre okunur. AI_API_KEY hepsini ezer.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Boş bırakılırsa her adaptör kendi varsayılanını kullanır:
#   anthropic -> claude-opus-5
#   gemini    -> gemini-2.5-flash
#   openai    -> gpt-5.4-mini
# AI_MODEL=

# Sadece anthropic. Onboarding'in 25sn P95 bütçesi için düşük tutuldu;
# öneri kalitesi yetersizse medium/high dene.
AI_EFFORT=low
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=4096
# Kullanıcı başına, scope başına günlük üretim limiti. 0 = limitsiz.
AI_DAILY_QUOTA=20
