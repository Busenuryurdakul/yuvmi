# Optional. Leave unset in Expo Go — the app talks to Metro, which proxies /api to Go.
# Physical device / LAN override example: http://192.168.1.103:8081
EXPO_PUBLIC_API_URL=

# Dev auth bridge — only "1" in local development builds (see eas.json)
EXPO_PUBLIC_ALLOW_DEV_AUTH=1
EXPO_PUBLIC_DEV_OAUTH_PASSWORD=yuvmi-dev-12345678

# Google OAuth — https://docs.expo.dev/guides/google-authentication/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
