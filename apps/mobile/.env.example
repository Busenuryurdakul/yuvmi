# Optional. Leave unset in Expo Go — the app talks to Metro, which proxies /api to Go.
# Physical device / LAN override example: http://192.168.1.103:8081
EXPO_PUBLIC_API_URL=

# Dev auth bridge — only "1" in local development builds (see eas.json)
EXPO_PUBLIC_ALLOW_DEV_AUTH=1
EXPO_PUBLIC_DEV_OAUTH_PASSWORD=yuvmi-dev-12345678

# Google OAuth — https://docs.expo.dev/guides/google-authentication/
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Yasal ve destek bağlantıları. Hepsi opsiyoneldir: boş bırakılırsa Profil →
# Destek satırları uygulama içindeki /legal ekranlarını açar, yani hiçbir
# derlemede kırık bağlantı olmaz. Yayımlanmış bir sayfa varsa buraya https://
# adresini yazmak satırı ona yönlendirir.
#
# NOT: mağaza kaydı (App Store Connect / Play Console) ayrıca herkese açık bir
# gizlilik politikası URL'si ister; uygulama içi ekran onun yerine geçmez.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Ayarlanmazsa destek ekranında e-posta düğmesi hiç görünmez — okunmayan bir
# adresi göstermektense göstermemek daha iyi.
EXPO_PUBLIC_SUPPORT_EMAIL=
