{
  "expo": {
    "name": "Yuvmi",
    "slug": "yuvmi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yuvmi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuvmi.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.yuvmi.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E7ECF9"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
