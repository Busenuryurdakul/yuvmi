{
  "expo": {
    "name": "Yuvmi",
    "slug": "yuvmi",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "yuvmi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuvmi.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.yuvmi.app",
      "adaptiveIcon": {
        "backgroundColor": "#E7ECF9"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E7ECF9",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
